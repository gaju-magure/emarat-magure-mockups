# ===========================================
# Theme Configuration
# ===========================================
# Configure which theme to load by default
# This allows the same codebase to be deployed
# with different branding for different domains

# Theme URL - Path to the theme JSON file
# Examples:
#   - Emarat branding: /themes/emarat/theme.json
#   - Magure branding: /themes/mgai/theme.json
#   - Custom theme:    /themes/custom/theme.json
#   - External URL:    https://cdn.example.com/theme.json
VITE_THEME_URL=/themes/mgai/theme.json

# Theme Mode - Default color mode
# Options: light | dark
VITE_THEME_MODE=light

# ===========================================
# Deployment Examples
# ===========================================

# Example 1: Emarat Deployment
# VITE_THEME_URL=/themes/emarat/theme.json
# VITE_THEME_MODE=light

# Example 2: Magure Deployment
# VITE_THEME_URL=/themes/mgai/theme.json
# VITE_THEME_MODE=light

# Example 3: Custom Partner Deployment
# VITE_THEME_URL=/themes/partner-name/theme.json
# VITE_THEME_MODE=dark

# Example 4: External Theme (CDN)
# VITE_THEME_URL=https://cdn.partner.com/branding/theme.json
# VITE_THEME_MODE=light

# ===========================================
# Notes
# ===========================================
# - Environment variables must be prefixed with VITE_ to be exposed to the client
# - Changes to .env require rebuilding the app (npm run build)
# - For local development, create a .env file and copy these settings
# - For production deployments, set these in your hosting platform's environment settings
